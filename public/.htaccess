# adlcoalition.org on NameHero (Apache/LiteSpeed). Static site + small PHP form/admin.
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /not-found.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Production canonical host: www.adlcoalition.org -> adlcoalition.org (fixed target, not the request's Host)
RewriteCond %{HTTP_HOST} ^www\.adlcoalition\.org$ [NC]
RewriteRule ^ https://adlcoalition.org%{REQUEST_URI} [L,R=301]
# Force HTTPS (server's own TLS state only; NameHero terminates TLS itself)
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# Old ?lang=fr links go to the French pages
RewriteCond %{QUERY_STRING} (^|&)lang=fr(&|$)
RewriteRule ^$ /fr/? [L,R=301]
RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
RewriteRule ^$ /en/? [L,R=301]
# Old /calendar link
RewriteRule ^calendar/?$ /en/calendar/ [L,R=301]
</IfModule>

# Never serve hidden files, sources, backups or databases
<FilesMatch "(^\.|\.(sql|sqlite|sqlite-wal|sqlite-shm|db|md|log|bak|old|orig|swp|ini|sh|lock|env)$|~$)">
  Require all denied
</FilesMatch>
# Project/config JSON never belongs on the server (Next.js's own /_next/ JSON files stay allowed)
<FilesMatch "^(package|package-lock|tsconfig|composer|components)\.json$">
  Require all denied
</FilesMatch>

# The temporary test address must never appear in search engines
SetEnvIfNoCase Host "^adlc-test\." ADLC_TEST_HOST

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-Robots-Tag "noindex, nofollow" env=ADLC_TEST_HOST
  Header always unset X-Powered-By
  Header unset X-Powered-By
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-src https://calendar.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|ico|webp)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
